{
  "name": "international-trade-web",
  "version": "1.0.0",
  "description": "Production-ready multilingual international trade website and merchant CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:blank": "cross-env NODE_OPTIONS=--no-deprecation SITE_VARIANT=blank next build",
    "build:demo": "cross-env NODE_OPTIONS=--no-deprecation SITE_VARIANT=demo next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:blank": "cross-env NODE_OPTIONS=--no-deprecation SITE_VARIANT=blank next dev",
    "dev:demo": "cross-env NODE_OPTIONS=--no-deprecation SITE_VARIANT=demo next dev",
    "dev:prod": "pnpm build && pnpm start",
    "data:import": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-sqlite-to-postgres.ts",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:demo": "cross-env NODE_OPTIONS=--no-deprecation SITE_VARIANT=demo tsx scripts/seed-demo.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "storage:check": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-media-integrity.ts",
    "storage:configure": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/configure-object-storage.ts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/run-test-command.ts e2e",
    "test:e2e:raw": "cross-env NODE_OPTIONS=--no-deprecation playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/run-test-command.ts int",
    "test:int:raw": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1096.0",
    "@payloadcms/admin-bar": "3.87.1",
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/email-nodemailer": "3.87.1",
    "@payloadcms/live-preview-react": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/plugin-nested-docs": "3.87.1",
    "@payloadcms/plugin-redirects": "3.87.1",
    "@payloadcms/plugin-seo": "3.87.1",
    "@payloadcms/richtext-lexical": "3.87.1",
    "@payloadcms/storage-s3": "3.87.1",
    "@payloadcms/translations": "3.87.1",
    "@payloadcms/ui": "3.87.1",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "jsdom": "28.0.0",
    "lucide-react": "0.563.0",
    "marked": "16.4.2",
    "next": "16.2.11",
    "opencc-js": "1.4.1",
    "payload": "3.87.1",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "redis": "^5.10.0",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/jsdom": "27.0.0",
    "@types/node": "22.19.9",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.0",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.11",
    "pg": "^8.16.3",
    "postcss": "8.5.24",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.9.0"
}
