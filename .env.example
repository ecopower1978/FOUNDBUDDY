# Runtime
NODE_ENV=development
SITE_VARIANT=blank
SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/international_trade_dev
DATABASE_POOL_MAX=10
PAYLOAD_DB_PUSH=true
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PREVIEW_SECRET=replace-with-at-least-24-random-characters
CRON_SECRET=replace-with-at-least-24-random-characters
TRUST_PROXY_HEADERS=false

# S3-compatible media storage (local Compose uses MinIO)
S3_BUCKET=international-trade-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://127.0.0.1:9000/international-trade-dev
S3_FORCE_PATH_STYLE=true

# Distributed state
REDIS_URL=redis://127.0.0.1:6379

# SMTP (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
# Use only for image builds/tests; runtime should verify the real transport.
SMTP_SKIP_VERIFY=false

# Optional translation integration
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Optional AI customer service fallback. Owner accounts can override these in
# Admin > System settings > Customer service API.
AI_CHAT_API_URL=
AI_CHAT_API_KEY=
# bearer (default), raw (the existing agent platform), x-api-key, or none
AI_CHAT_AUTH_SCHEME=bearer
# Required in production when article agents submit remote cover image URLs.
# Comma-separated exact hosts or wildcard subdomains, e.g. images.example.com,*.cdn.example.com
AGENT_IMAGE_ALLOWED_HOSTS=

# Optional automation API; the route returns 404 when this is empty
BLOG_PUBLISH_TOKEN=
BLOG_PUBLISH_TOKEN_PREVIOUS=

# Staging may begin with CSP reporting before enforcement
CSP_REPORT_ONLY=false
